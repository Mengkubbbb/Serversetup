# Server setup maker — configuration
# Copy to .env and adjust. Never commit .env.

# --- HTTP ---
PORT=8787
# Bind address. Keep 127.0.0.1 for local-only usage behind a reverse proxy.
HOST=127.0.0.1
# Vite dev server proxies /api to this port.
API_PORT=8787

# --- Storage ---
# All persistent state (SQLite DB, plugin files, templates) lives here.
DATA_DIR=./storage
# Maximum single upload size in bytes (default 64 MiB).
MAX_UPLOAD_BYTES=67108864
# Maximum number of entries inspected inside an uploaded ZIP.
MAX_ARCHIVE_ENTRIES=2000
# Maximum uncompressed bytes accepted from an uploaded ZIP.
MAX_EXTRACTED_BYTES=268435456
# Maximum plugin download size in bytes (default 128 MiB).
MAX_DOWNLOAD_BYTES=134217728
# Outbound request timeout for metadata/download calls (ms).
REQUEST_TIMEOUT_MS=20000

# --- Modrinth ---
# Modrinth requires a descriptive User-Agent (contact info recommended).
MODRINTH_USER_AGENT=serversetup-maker/1.0 (self-hosted; admin@example.invalid)

# --- Optional: GitHub token for Leaf build metadata (avoids rate limits) ---
# GITHUB_TOKEN=

# --- AI provider (optional; app is fully usable without it) ---
# Providers: openai | openai-compatible | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For openai-compatible providers, set the API root (no trailing /chat/completions).
AI_BASE_URL=https://api.openai.com/v1

# --- Security ---
# Comma separated extra hosts allowed to call the API via CORS (dev uses the
# Vite proxy, so this can usually stay empty).
CORS_ORIGINS=
